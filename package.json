  "dependencies": {
    "@google/genai": "^2.23.0",
    "@serwist/next": "9.5.12",
    "bcryptjs": "2.4.3",
    "better-sqlite3": "11.8.1",
    "next": "15.5.25",
    "react": "19.0.3",
    "react-dom": "19.0.3",
    "server-only": "0.0.1",
    "serwist": "9.5.12",
    "sharp": "0.35.4",
    "web-push": "3.6.7"
  },
  "overrides": {
    "workbox-navigation-prefetch": "npm:workbox-routing@7.3.0",
